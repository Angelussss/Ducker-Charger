 892:Core/Src/ui/screens.c **** void Screen_Warning_Draw(void)
 893:Core/Src/ui/screens.c **** {
 894:Core/Src/ui/screens.c ****     char buf[24];
 895:Core/Src/ui/screens.c ****     const WarnText_t *w = &_warn_text[_warn_type];
 896:Core/Src/ui/screens.c ****     uint16_t wc = (_warn_type == WARN_VCRIT) ? COLOR_DANGER : COLOR_ORANGE;
 897:Core/Src/ui/screens.c **** 
 898:Core/Src/ui/screens.c ****     ILI9341_FillScreen(COLOR_BG);
 899:Core/Src/ui/screens.c **** 
 900:Core/Src/ui/screens.c ****     /* warning triangle, thick border (3 passes), big "!" inside */
 901:Core/Src/ui/screens.c ****     for (uint8_t t = 0; t < 3; t++) {
 902:Core/Src/ui/screens.c ****         GFX_DrawLine(120, 52 + t, 68 + t, 148 - t, wc);
 903:Core/Src/ui/screens.c ****         GFX_DrawLine(120, 52 + t, 172 - t, 148 - t, wc);
 904:Core/Src/ui/screens.c ****         GFX_DrawLine(70, 146 + t, 170, 146 + t, wc);
 905:Core/Src/ui/screens.c ****     }
 906:Core/Src/ui/screens.c ****     GFX_DrawStringScaled(109, 90, "!", &GFX_FontSmall, 5, wc, COLOR_BG);
 907:Core/Src/ui/screens.c **** 
 908:Core/Src/ui/screens.c ****     /* centred title: x = (240 - strlen*14) / 2 (scale 2 glyph = 14 px) */
 909:Core/Src/ui/screens.c ****     GFX_DrawStringScaled((uint16_t)((240 - strlen(w->title) * 14) / 2), 168,
 910:Core/Src/ui/screens.c ****                          w->title, &GFX_FontSmall, 2, wc, COLOR_BG);
 911:Core/Src/ui/screens.c **** 
 912:Core/Src/ui/screens.c ****     /* centred lines: x = (240 - strlen*6) / 2 */
 913:Core/Src/ui/screens.c ****     for (uint8_t i = 0; i < 3; i++)
 914:Core/Src/ui/screens.c ****         if (w->line[i][0])
 915:Core/Src/ui/screens.c ****             GFX_DrawString((uint16_t)((240 - strlen(w->line[i]) * 6) / 2),
 916:Core/Src/ui/screens.c ****                            200 + i * 12, w->line[i],
 917:Core/Src/ui/screens.c ****                            &GFX_FontSmall, COLOR_WHITE, COLOR_BG);
 918:Core/Src/ui/screens.c **** 
 919:Core/Src/ui/screens.c ****     /* the number that matters */
 920:Core/Src/ui/screens.c ****     if (_warn_type == WARN_TEMP) {
 921:Core/Src/ui/screens.c ****         snprintf(buf, sizeof(buf), "%d C", telemetry.temp_celsius);
 922:Core/Src/ui/screens.c ****         GFX_DrawStringScaled(96, 240, buf, &GFX_FontSmall, 2,
 923:Core/Src/ui/screens.c ****                              temp_color_pub(telemetry.temp_celsius), COLOR_BG);
 924:Core/Src/ui/screens.c ****     } else {
