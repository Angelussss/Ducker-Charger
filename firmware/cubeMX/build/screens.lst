 926:Core/Src/ui/screens.c ****                  (telemetry.voltage_mV % 1000) / 10);
 927:Core/Src/ui/screens.c ****         GFX_DrawStringScaled(85, 240, buf, &GFX_FontSmall, 2,
 928:Core/Src/ui/screens.c ****                              COLOR_DANGER, COLOR_BG);
ARM GAS  /tmp/cczpKMPG.s 			page 37


 929:Core/Src/ui/screens.c ****     }
