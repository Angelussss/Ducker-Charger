 104:Core/Src/ui/screens.c **** /* =========================================================
 105:Core/Src/ui/screens.c ****  * Colour helpers — shared with widgets.c
 106:Core/Src/ui/screens.c ****  * ========================================================= */
 107:Core/Src/ui/screens.c **** 
 108:Core/Src/ui/screens.c **** /* alarm thresholds, one place only, easy to poke */
 109:Core/Src/ui/screens.c **** #define TH_SOC_ORANGE      15     /* below this % -> orange */
 110:Core/Src/ui/screens.c **** #define TH_SOC_RED          5     /* below this % -> red  */
 111:Core/Src/ui/screens.c **** #define TH_TEMP_ORANGE     45     /* C */
 112:Core/Src/ui/screens.c **** #define TH_TEMP_RED        60     /* C */
 113:Core/Src/ui/screens.c **** #define TH_TEMP_COLD       10     /* below this C -> cyan + warning */
ARM GAS  /tmp/cczpKMPG.s 			page 4


 114:Core/Src/ui/screens.c **** #define TH_VOLT_GREEN_MV   14000  /* 14-17 V: green, all good */
 115:Core/Src/ui/screens.c **** #define TH_VOLT_ORANGE_MV  13000  /* 13-14 V: orange, keep eye on it */
 116:Core/Src/ui/screens.c **** #define TH_VOLT_RED_MV     12000  /* 12-13 V red; below: red that blinks */
 117:Core/Src/ui/screens.c **** 
 118:Core/Src/ui/screens.c **** uint16_t battery_color_pub(uint8_t pct)
 119:Core/Src/ui/screens.c **** {
 120:Core/Src/ui/screens.c ****     if (pct < TH_SOC_RED)    return COLOR_DANGER;
 121:Core/Src/ui/screens.c ****     if (pct < TH_SOC_ORANGE) return COLOR_ORANGE;
 122:Core/Src/ui/screens.c ****     return COLOR_GREEN;
 123:Core/Src/ui/screens.c **** }
 124:Core/Src/ui/screens.c **** 
 125:Core/Src/ui/screens.c **** uint16_t temp_color_pub(int16_t temp_c)
 126:Core/Src/ui/screens.c **** {
 127:Core/Src/ui/screens.c ****     if (temp_c >= TH_TEMP_RED)    return COLOR_DANGER;
 128:Core/Src/ui/screens.c ****     if (temp_c >= TH_TEMP_ORANGE) return COLOR_ORANGE;
 129:Core/Src/ui/screens.c ****     if (temp_c <  TH_TEMP_COLD)   return COLOR_CYAN;   /* brrr, cold */
 130:Core/Src/ui/screens.c ****     return COLOR_WHITE;
 131:Core/Src/ui/screens.c **** }
 132:Core/Src/ui/screens.c **** 
 133:Core/Src/ui/screens.c **** /** 1 when temp outside comfort cave. show warning then. */
 134:Core/Src/ui/screens.c **** uint8_t temp_out_of_range_pub(int16_t temp_c)
 135:Core/Src/ui/screens.c **** {
 136:Core/Src/ui/screens.c ****     return (temp_c > TH_TEMP_RED) || (temp_c < TH_TEMP_COLD);
 137:Core/Src/ui/screens.c **** }
 138:Core/Src/ui/screens.c **** 
 139:Core/Src/ui/screens.c **** #define TH_CELL_ORANGE_MV  3250   /* per single parallel group */
 140:Core/Src/ui/screens.c **** #define TH_CELL_RED_MV     3050
 141:Core/Src/ui/screens.c **** 
