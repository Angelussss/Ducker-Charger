  47:Core/Src/ui/screens.c **** static void draw_header(const char *title)
  48:Core/Src/ui/screens.c **** {
  49:Core/Src/ui/screens.c ****     ILI9341_FillRect(0, HEADER_Y, ILI9341_WIDTH, HEADER_H, COLOR_HEADER);
  50:Core/Src/ui/screens.c ****     GFX_DrawHLine(0, HEADER_Y + HEADER_H - 2, ILI9341_WIDTH, COLOR_ACCENT);
  51:Core/Src/ui/screens.c ****     GFX_DrawHLine(0, HEADER_Y + HEADER_H - 1, ILI9341_WIDTH, COLOR_ACCENT);
  52:Core/Src/ui/screens.c ****     GFX_DrawString(8, HEADER_Y + 10, title, &GFX_FontMedium, COLOR_WHITE, COLOR_HEADER);
  53:Core/Src/ui/screens.c ****     Screen_Header_RefreshIcons();
  54:Core/Src/ui/screens.c **** }
  55:Core/Src/ui/screens.c **** 
  56:Core/Src/ui/screens.c **** /* called on every periodic tick so icons track live telemetry on all screens */
  57:Core/Src/ui/screens.c **** void Screen_Header_RefreshIcons(void)
  58:Core/Src/ui/screens.c **** {
  59:Core/Src/ui/screens.c ****     ILI9341_FillRect(150, HEADER_Y + 4, 88, HEADER_H - 10, COLOR_HEADER);
  60:Core/Src/ui/screens.c **** 
  61:Core/Src/ui/screens.c ****     /* thermometer: red when hot, cyan when cold. no icon = temp good */
  62:Core/Src/ui/screens.c ****     if (telemetry.temp_celsius >= 45)
  63:Core/Src/ui/screens.c ****         Widget_StatusIcon_Draw(170, HEADER_Y + 10, ICON_TEMP_WARN, "", 1);
  64:Core/Src/ui/screens.c ****     else if (telemetry.temp_celsius < 10)
  65:Core/Src/ui/screens.c ****         Widget_StatusIcon_Draw(170, HEADER_Y + 10, ICON_TEMP_COLD, "", 1);
  66:Core/Src/ui/screens.c **** 
  67:Core/Src/ui/screens.c ****     /* blinking "!" = voltage very low. bad. */
  68:Core/Src/ui/screens.c ****     if (volt_alarm_pub(telemetry.voltage_mV) == 2 &&
  69:Core/Src/ui/screens.c ****         ((HAL_GetTick() / 500) & 1))
  70:Core/Src/ui/screens.c ****         Widget_StatusIcon_Draw(155, HEADER_Y + 10, ICON_ALERT, "", 1);
  71:Core/Src/ui/screens.c **** 
  72:Core/Src/ui/screens.c ****     /* USB-C plug when a supply is attached */
  73:Core/Src/ui/screens.c ****     if (telemetry.vbus_present)
  74:Core/Src/ui/screens.c ****         Widget_StatusIcon_Draw(200, HEADER_Y + 10, ICON_USB_C, "", 1);
  75:Core/Src/ui/screens.c **** 
  76:Core/Src/ui/screens.c ****     /* Bolt while charging, check when full, down arrow while discharging */
  77:Core/Src/ui/screens.c ****     if (telemetry.is_full)
  78:Core/Src/ui/screens.c ****         Widget_StatusIcon_Draw(185, HEADER_Y + 10, ICON_FULL, "", 1);
  79:Core/Src/ui/screens.c ****     else if (telemetry.is_charging)
  80:Core/Src/ui/screens.c ****         Widget_StatusIcon_Draw(185, HEADER_Y + 10, ICON_CHARGING, "", 1);
  81:Core/Src/ui/screens.c ****     else if (telemetry.current_mA < 0)
  82:Core/Src/ui/screens.c ****         Widget_StatusIcon_Draw(185, HEADER_Y + 10, ICON_DISCHARGING, "", 1);
  83:Core/Src/ui/screens.c **** }
