 361:Core/Src/ui/screens.c **** 
 362:Core/Src/ui/screens.c ****     /* SoC */
 363:Core/Src/ui/screens.c ****     snprintf(buf, sizeof(buf), "%d%%", telemetry.soc_percent);
 364:Core/Src/ui/screens.c ****     detail_value(DETAIL_COL_A, DETAIL_ROW_1 + val_y,
