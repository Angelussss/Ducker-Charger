 366:Core/Src/ui/screens.c **** 
 367:Core/Src/ui/screens.c ****     /* Voltage */
 368:Core/Src/ui/screens.c ****     snprintf(buf, sizeof(buf), "%d.%02dV",
 369:Core/Src/ui/screens.c ****              telemetry.voltage_mV / 1000,
 370:Core/Src/ui/screens.c ****              (telemetry.voltage_mV % 1000) / 10);
 371:Core/Src/ui/screens.c ****     detail_value(DETAIL_COL_B, DETAIL_ROW_1 + val_y, buf,
 372:Core/Src/ui/screens.c ****                  volt_color_pub(telemetry.voltage_mV));
 373:Core/Src/ui/screens.c **** 
 374:Core/Src/ui/screens.c ****     /* Current */
 375:Core/Src/ui/screens.c ****     snprintf(buf, sizeof(buf), "%+dmA", telemetry.current_mA);
 376:Core/Src/ui/screens.c ****     detail_value(DETAIL_COL_A, DETAIL_ROW_2 + val_y,
 377:Core/Src/ui/screens.c ****                  buf, current_color(telemetry.current_mA));
 378:Core/Src/ui/screens.c **** 
 379:Core/Src/ui/screens.c ****     /* Power */
