 494:Core/Src/ui/screens.c **** 
 495:Core/Src/ui/screens.c **** static void ports_graph(void)
 496:Core/Src/ui/screens.c **** {
 497:Core/Src/ui/screens.c ****     /* Clear + frame once, then overlay one trace per active port. */
 498:Core/Src/ui/screens.c ****     ILI9341_FillRect(PORTS_GRAPH_X, PORTS_GRAPH_Y,
 499:Core/Src/ui/screens.c ****                      PORTS_GRAPH_W, PORTS_GRAPH_H, COLOR_BG);
 500:Core/Src/ui/screens.c ****     GFX_DrawRect(PORTS_GRAPH_X, PORTS_GRAPH_Y,
 501:Core/Src/ui/screens.c ****                  PORTS_GRAPH_W, PORTS_GRAPH_H, COLOR_GRAY);
 502:Core/Src/ui/screens.c **** 
 503:Core/Src/ui/screens.c ****     for (uint8_t i = 0; i < 5; i++)
 504:Core/Src/ui/screens.c ****     {
 505:Core/Src/ui/screens.c ****         if (!port_stats[i].active) continue;
 506:Core/Src/ui/screens.c ****         Widget_LineGraph_Trace(PORTS_GRAPH_X + 1, PORTS_GRAPH_Y + 1,
 507:Core/Src/ui/screens.c ****                                PORTS_GRAPH_W - 2, PORTS_GRAPH_H - 2,
