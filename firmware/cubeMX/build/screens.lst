 403:Core/Src/ui/screens.c ****     const char *state_str   = telemetry.vbus_present
 404:Core/Src/ui/screens.c ****                               ? phase_str[telemetry.charge_phase & 0x03]
 405:Core/Src/ui/screens.c ****                               : "NO INPUT";
