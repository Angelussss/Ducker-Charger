 395:Core/Src/ui/screens.c ****                        &GFX_FontSmall, COLOR_GRAY, COLOR_BG);
 396:Core/Src/ui/screens.c ****         ILI9341_FillRect(cx, DETAIL_CELLS_Y + 22, 30, GFX_FONT_SMALL_H, COLOR_BG);
 397:Core/Src/ui/screens.c ****         GFX_DrawString(cx, DETAIL_CELLS_Y + 22, buf,
 398:Core/Src/ui/screens.c ****                        &GFX_FontSmall, cell_color(cell_mv[i]), COLOR_BG);
 399:Core/Src/ui/screens.c ****     }
