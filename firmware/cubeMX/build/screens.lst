 385:Core/Src/ui/screens.c ****     detail_value(DETAIL_COL_A, DETAIL_ROW_3 + val_y,
 386:Core/Src/ui/screens.c ****                  buf, temp_color_pub(telemetry.temp_celsius));
 387:Core/Src/ui/screens.c **** 
 388:Core/Src/ui/screens.c ****     /* one voltage per group, colour from per-cell thresholds */
