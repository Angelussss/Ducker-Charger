 148:Core/Src/ui/screens.c **** 
 149:Core/Src/ui/screens.c **** uint16_t volt_color_pub(uint16_t mv)
 150:Core/Src/ui/screens.c **** {
 151:Core/Src/ui/screens.c ****     if (mv < TH_VOLT_RED_MV)          /* critico: rosso lampeggiante */
 152:Core/Src/ui/screens.c ****         return ((HAL_GetTick() / 500) & 1) ? COLOR_DANGER : COLOR_DARKGRAY;
 153:Core/Src/ui/screens.c ****     if (mv < TH_VOLT_ORANGE_MV) return COLOR_DANGER;
 154:Core/Src/ui/screens.c ****     if (mv < TH_VOLT_GREEN_MV)  return COLOR_ORANGE;
 155:Core/Src/ui/screens.c ****     return COLOR_GREEN;
 156:Core/Src/ui/screens.c **** }
 157:Core/Src/ui/screens.c **** 
 158:Core/Src/ui/screens.c **** /* 0 = fine, 1 = warn (12-13 V), 2 = very bad (<12 V) */
 159:Core/Src/ui/screens.c **** uint8_t volt_alarm_pub(uint16_t mv)
 160:Core/Src/ui/screens.c **** {
 161:Core/Src/ui/screens.c ****     if (mv < TH_VOLT_RED_MV)    return 2;
 162:Core/Src/ui/screens.c ****     if (mv < TH_VOLT_ORANGE_MV) return 1;
 163:Core/Src/ui/screens.c ****     return 0;
 164:Core/Src/ui/screens.c **** }
