 949:Core/Src/ui/screens.c **** 
 950:Core/Src/ui/screens.c **** /**
 951:Core/Src/ui/screens.c ****  * @brief  Descriptor for one settings menu row.
 952:Core/Src/ui/screens.c ****  *
 953:Core/Src/ui/screens.c ****  * The `static` keyword means this array keeps its values between calls,
 954:Core/Src/ui/screens.c ****  * so the ON/OFF toggle state persists across screen transitions.
 955:Core/Src/ui/screens.c ****  */
 956:Core/Src/ui/screens.c **** typedef struct {
 957:Core/Src/ui/screens.c ****     const char   *name;       /**< Display name */
 958:Core/Src/ui/screens.c ****     GPIO_TypeDef *gpio_port;  /**< GPIO port controlling the output */
