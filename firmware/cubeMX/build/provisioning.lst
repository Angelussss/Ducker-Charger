 116:Core/Src/app/provisioning.c **** /** Control() subcommand round-trip: write, settle, read the response. */
 117:Core/Src/app/provisioning.c **** static HAL_StatusTypeDef control_read(uint16_t sub, uint16_t *out)
 118:Core/Src/app/provisioning.c **** {
 119:Core/Src/app/provisioning.c ****     uint8_t d[2];
 120:Core/Src/app/provisioning.c **** 
 121:Core/Src/app/provisioning.c ****     if (control_write(sub) != HAL_OK)
 122:Core/Src/app/provisioning.c ****         return HAL_ERROR;
 123:Core/Src/app/provisioning.c ****     HAL_Delay(2);
 124:Core/Src/app/provisioning.c ****     if (reg_read(REG_CNTL, d, 2u) != HAL_OK)
 125:Core/Src/app/provisioning.c ****         return HAL_ERROR;
 126:Core/Src/app/provisioning.c **** 
 127:Core/Src/app/provisioning.c ****     *out = (uint16_t)d[0] | ((uint16_t)d[1] << 8);
 128:Core/Src/app/provisioning.c ****     return HAL_OK;
 129:Core/Src/app/provisioning.c **** }
