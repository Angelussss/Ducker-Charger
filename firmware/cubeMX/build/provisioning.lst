   1:Core/Src/app/provisioning.c **** /**
   2:Core/Src/app/provisioning.c ****  * @file    provisioning.c
   3:Core/Src/app/provisioning.c ****  * @brief   BQ34Z100-R2 data-flash provisioning. See provisioning.h.
   4:Core/Src/app/provisioning.c ****  *
   5:Core/Src/app/provisioning.c ****  * Data-flash access protocol (BQ34Z100-R2 TRM, "Accessing Data Flash"):
   6:Core/Src/app/provisioning.c ****  *   0x61  BlockDataControl  (write 0x00 to enable block access)
   7:Core/Src/app/provisioning.c ****  *   0x3E  DataFlashClass    (subclass id)
   8:Core/Src/app/provisioning.c ****  *   0x3F  DataFlashBlock    (32-byte block index within the subclass)
   9:Core/Src/app/provisioning.c ****  *   0x40..0x5F              32-byte block data window
  10:Core/Src/app/provisioning.c ****  *   0x60  BlockDataChecksum (255 - (sum of block bytes) & 0xFF)
  11:Core/Src/app/provisioning.c ****  *
  12:Core/Src/app/provisioning.c ****  * VERIFY BEFORE FIRST USE (marked CHECK):
  13:Core/Src/app/provisioning.c ****  *   - Subclass IDs and offsets against the BQ34Z100-R2 TRM data-flash
  14:Core/Src/app/provisioning.c ****  *     table (the TRM is already in the repo docs). The values below
  15:Core/Src/app/provisioning.c ****  *     follow the TRM naming but MUST be cross-checked once.
  16:Core/Src/app/provisioning.c ****  *   - Unseal keys: 0x0414/0x3672 are the TI defaults; if the gauge is
  17:Core/Src/app/provisioning.c ****  *     ever sealed with custom keys, update them here.
  18:Core/Src/app/provisioning.c ****  *   - The pack sits behind the ISO1540 on I2C_LP: all accesses go
  19:Core/Src/app/provisioning.c ****  *     through the normal hi2c1 path, nothing special needed.
  20:Core/Src/app/provisioning.c ****  */
  21:Core/Src/app/provisioning.c **** 
  22:Core/Src/app/provisioning.c **** #include "app/provisioning.h"
  23:Core/Src/app/provisioning.c **** #include "main.h"
  24:Core/Src/app/provisioning.c **** #include "i2c.h"        /* hi2c1 (I2C_LP -> ISO1540 -> gauge) */
  25:Core/Src/app/provisioning.c **** 
  26:Core/Src/app/provisioning.c **** #include <string.h>
  27:Core/Src/app/provisioning.c **** #include <stdlib.h>
  28:Core/Src/app/provisioning.c **** 
  29:Core/Src/app/provisioning.c **** #define GAUGE_ADDR              (0x55u << 1)
  30:Core/Src/app/provisioning.c **** #define I2C_TIMEOUT_MS          (50u)
ARM GAS  /tmp/ccWANuVb.s 			page 2


  31:Core/Src/app/provisioning.c **** 
  32:Core/Src/app/provisioning.c **** /* Standard commands */
  33:Core/Src/app/provisioning.c **** #define REG_CNTL                (0x00u)   /* Control(), 2 bytes */
  34:Core/Src/app/provisioning.c **** #define REG_AI                  (0x0Au)   /* AverageCurrent, mA  */
  35:Core/Src/app/provisioning.c **** #define REG_BDC                 (0x61u)   /* BlockDataControl    */
  36:Core/Src/app/provisioning.c **** #define REG_DF_CLASS            (0x3Eu)
  37:Core/Src/app/provisioning.c **** #define REG_DF_BLOCK            (0x3Fu)
  38:Core/Src/app/provisioning.c **** #define REG_BLOCK_DATA          (0x40u)
  39:Core/Src/app/provisioning.c **** #define REG_BLOCK_CSUM          (0x60u)
  40:Core/Src/app/provisioning.c **** 
  41:Core/Src/app/provisioning.c **** /* Control() subcommands */
  42:Core/Src/app/provisioning.c **** #define CNTL_UNSEAL_KEY1        (0x0414u)
  43:Core/Src/app/provisioning.c **** #define CNTL_UNSEAL_KEY2        (0x3672u)
  44:Core/Src/app/provisioning.c **** #define CNTL_RESET              (0x0041u)
  45:Core/Src/app/provisioning.c **** #define CNTL_DEVICE_TYPE        (0x0001u)
  46:Core/Src/app/provisioning.c **** 
  47:Core/Src/app/provisioning.c **** /* Control() DEVICE_TYPE response for the BQ34Z100 family. */
  48:Core/Src/app/provisioning.c **** #define GAUGE_DEVICE_TYPE       (0x0100u)
  49:Core/Src/app/provisioning.c **** 
  50:Core/Src/app/provisioning.c **** /* Safety: refuse DF writes unless |AverageCurrent| below this. */
  51:Core/Src/app/provisioning.c **** #define PROV_MAX_REST_MA        (50)
  52:Core/Src/app/provisioning.c **** 
  53:Core/Src/app/provisioning.c **** /* =========================================================
  54:Core/Src/app/provisioning.c ****  * Pack parameters (CHECK every subclass/offset against the TRM table)
  55:Core/Src/app/provisioning.c ****  * ========================================================= */
  56:Core/Src/app/provisioning.c **** 
  57:Core/Src/app/provisioning.c **** /* Subclass 48 "Data": Design Capacity (mAh, big endian in DF).
  58:Core/Src/app/provisioning.c ****  * 3P of Murata VTC5 (2600 mAh) = 7800 mAh — adjust if cells change. */
  59:Core/Src/app/provisioning.c **** #define SUBCLASS_DATA           (48u)
  60:Core/Src/app/provisioning.c **** #define OFF_DESIGN_CAPACITY     (11u)     /* CHECK: TRM offset */
  61:Core/Src/app/provisioning.c **** static const uint8_t design_capacity[2] = { (7800u >> 8) & 0xFFu,
  62:Core/Src/app/provisioning.c ****                                              7800u & 0xFFu };
  63:Core/Src/app/provisioning.c **** 
  64:Core/Src/app/provisioning.c **** /* Subclass 64 "Registers": Pack Configuration + Number of Series Cells.
  65:Core/Src/app/provisioning.c ****  * VOLTSEL (external divider) must be set for a 4S pack. */
  66:Core/Src/app/provisioning.c **** #define SUBCLASS_REGISTERS      (64u)
  67:Core/Src/app/provisioning.c **** #define OFF_PACK_CONFIG         (0u)      /* CHECK: TRM offset + bits  */
  68:Core/Src/app/provisioning.c **** #define OFF_SERIES_CELLS        (7u)      /* CHECK: TRM offset         */
  69:Core/Src/app/provisioning.c **** static const uint8_t series_cells[1] = { 4u };
  70:Core/Src/app/provisioning.c **** 
  71:Core/Src/app/provisioning.c **** /* Subclass 104 "Manufacturer Info Block A": we use the first two bytes
  72:Core/Src/app/provisioning.c ****  * as our provisioning marker ("DK" + revision). Bump the revision when
  73:Core/Src/app/provisioning.c ****  * the patch list changes so old units re-provision. */
  74:Core/Src/app/provisioning.c **** #define SUBCLASS_MFG_INFO_A     (58u)     /* CHECK: TRM subclass id */
  75:Core/Src/app/provisioning.c **** #define OFF_MARKER              (0u)
  76:Core/Src/app/provisioning.c **** #define PROV_MARKER_0           ((uint8_t)'D')
  77:Core/Src/app/provisioning.c **** #define PROV_MARKER_1           ((uint8_t)0x01)   /* pack config rev */
  78:Core/Src/app/provisioning.c **** static const uint8_t marker[2] = { PROV_MARKER_0, PROV_MARKER_1 };
  79:Core/Src/app/provisioning.c **** 
  80:Core/Src/app/provisioning.c **** static const GaugeDfPatch_t patches[] = {
  81:Core/Src/app/provisioning.c ****     { SUBCLASS_DATA,       OFF_DESIGN_CAPACITY, 2u, design_capacity },
  82:Core/Src/app/provisioning.c ****     { SUBCLASS_REGISTERS,  OFF_SERIES_CELLS,    1u, series_cells    },
  83:Core/Src/app/provisioning.c ****     /* Golden-image entries (Qmax, Ra tables, calibration) go here once
  84:Core/Src/app/provisioning.c ****      * the learning cycle on the sample pack has been run in bqStudio. */
  85:Core/Src/app/provisioning.c ****     { SUBCLASS_MFG_INFO_A, OFF_MARKER,          2u, marker          },
  86:Core/Src/app/provisioning.c **** };
  87:Core/Src/app/provisioning.c **** #define N_PATCHES  (sizeof(patches) / sizeof(patches[0]))
