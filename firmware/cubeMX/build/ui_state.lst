  70:Core/Src/ui/ui_state.c **** void UI_Tick(void)
  71:Core/Src/ui/ui_state.c **** {
  72:Core/Src/ui/ui_state.c ****     uint32_t now = HAL_GetTick();
  73:Core/Src/ui/ui_state.c **** 
  74:Core/Src/ui/ui_state.c ****     /* -------- Boot screen auto-transition -------- */
