 221:Core/Src/ui/ui_state.c ****     /* -------- per-screen navigation -------- */
 222:Core/Src/ui/ui_state.c **** 
 223:Core/Src/ui/ui_state.c ****     switch (ui_state.current_screen)
 224:Core/Src/ui/ui_state.c ****     {
 225:Core/Src/ui/ui_state.c ****         case UI_SCREEN_MAIN:
 226:Core/Src/ui/ui_state.c **** 
 227:Core/Src/ui/ui_state.c ****             /* from MAIN spin knob to move between screens.
 228:Core/Src/ui/ui_state.c ****              * press do nothing here (nothing to select) */
 229:Core/Src/ui/ui_state.c ****             if (enc_delta > 0) UI_NavigateTo(UI_SCREEN_DETAIL);
 230:Core/Src/ui/ui_state.c ****             if (enc_delta < 0) UI_NavigateTo(UI_SCREEN_STATS);   /* wrap around */
 231:Core/Src/ui/ui_state.c ****             break;
 232:Core/Src/ui/ui_state.c **** 
 233:Core/Src/ui/ui_state.c ****         case UI_SCREEN_DETAIL:
 234:Core/Src/ui/ui_state.c ****             if (enc_delta > 0) UI_NavigateTo(UI_SCREEN_GRAPH);
 235:Core/Src/ui/ui_state.c ****             if (enc_delta < 0) UI_NavigateTo(UI_SCREEN_MAIN);
 236:Core/Src/ui/ui_state.c ****             break;
 237:Core/Src/ui/ui_state.c **** 
 238:Core/Src/ui/ui_state.c ****         case UI_SCREEN_GRAPH:
 239:Core/Src/ui/ui_state.c ****             if (enc_delta > 0) UI_NavigateTo(UI_SCREEN_PORTS);
 240:Core/Src/ui/ui_state.c ****             if (enc_delta < 0) UI_NavigateTo(UI_SCREEN_DETAIL);
 241:Core/Src/ui/ui_state.c ****             if (click) Screen_Graph_CycleScale();
 242:Core/Src/ui/ui_state.c ****             break;
 243:Core/Src/ui/ui_state.c **** 
 244:Core/Src/ui/ui_state.c ****         case UI_SCREEN_PORTS:
 245:Core/Src/ui/ui_state.c ****             if (enc_delta > 0) UI_NavigateTo(UI_SCREEN_STATS);
 246:Core/Src/ui/ui_state.c ****             if (enc_delta < 0) UI_NavigateTo(UI_SCREEN_GRAPH);
 247:Core/Src/ui/ui_state.c ****             break;
 248:Core/Src/ui/ui_state.c **** 
 249:Core/Src/ui/ui_state.c ****         case UI_SCREEN_STATS:
 250:Core/Src/ui/ui_state.c ****             if (enc_delta > 0) UI_NavigateTo(UI_SCREEN_MAIN);    /* wrap around */
