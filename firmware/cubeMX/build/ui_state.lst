  78:Core/Src/ui/ui_state.c ****         {
  79:Core/Src/ui/ui_state.c ****             /* time over: go where boot say
  80:Core/Src/ui/ui_state.c ****              * (MAIN at power-on, old screen after light-sleep wake) */
  81:Core/Src/ui/ui_state.c ****             UI_NavigateTo(_boot_dest);
  82:Core/Src/ui/ui_state.c ****             _boot_dest     = UI_SCREEN_MAIN;
  83:Core/Src/ui/ui_state.c ****             _boot_duration = BOOT_SCREEN_DURATION_MS;
  84:Core/Src/ui/ui_state.c ****         }
  85:Core/Src/ui/ui_state.c **** 
  86:Core/Src/ui/ui_state.c ****         return;
