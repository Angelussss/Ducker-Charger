  89:Core/Src/ui/ui_state.c ****     /* -------- Read encoder input -------- */
  90:Core/Src/ui/ui_state.c **** 
  91:Core/Src/ui/ui_state.c ****     int8_t  enc_delta   = Encoder_GetDelta();
  92:Core/Src/ui/ui_state.c ****     uint8_t btn_pressed = Encoder_IsPressed();
  93:Core/Src/ui/ui_state.c **** 
  94:Core/Src/ui/ui_state.c ****     /* -------- sleep: any press wake up, everything else ignored -------- */
  95:Core/Src/ui/ui_state.c ****     if (ui_state.current_screen == UI_SCREEN_SLEEP)
  96:Core/Src/ui/ui_state.c ****     {
  97:Core/Src/ui/ui_state.c ****         if (btn_pressed)
  98:Core/Src/ui/ui_state.c ****         {
  99:Core/Src/ui/ui_state.c ****             if (_sleep_light)
 100:Core/Src/ui/ui_state.c ****             {
 101:Core/Src/ui/ui_state.c ****                 /* light sleep wake = little power-on: short logo splash */
 102:Core/Src/ui/ui_state.c ****                 _sleep_light   = 0;
 103:Core/Src/ui/ui_state.c ****                 _boot_dest     = _sleep_return;
 104:Core/Src/ui/ui_state.c ****                 _boot_duration = 1200;
 105:Core/Src/ui/ui_state.c ****                 _boot_start_tick = now;
 106:Core/Src/ui/ui_state.c ****                 UI_NavigateTo(UI_SCREEN_BOOT);
 107:Core/Src/ui/ui_state.c ****             }
 108:Core/Src/ui/ui_state.c ****             else
 109:Core/Src/ui/ui_state.c ****                 UI_NavigateTo(_sleep_return);
 110:Core/Src/ui/ui_state.c ****         }
 111:Core/Src/ui/ui_state.c ****         return;                     /* skip arbiter: wake press make no click */
 112:Core/Src/ui/ui_state.c ****     }
 113:Core/Src/ui/ui_state.c **** 
 114:Core/Src/ui/ui_state.c ****     /* -------- auto-sleep when user idle too long -------- */
 115:Core/Src/ui/ui_state.c ****     if (enc_delta != 0 || btn_pressed || Encoder_IsHeld())
 116:Core/Src/ui/ui_state.c ****         _last_activity = now;
 117:Core/Src/ui/ui_state.c ****     {
 118:Core/Src/ui/ui_state.c ****         uint32_t as = Screen_Display_GetAutoSleepMs();
 119:Core/Src/ui/ui_state.c ****         if (as > 0 && (now - _last_activity) >= as &&
 120:Core/Src/ui/ui_state.c ****             ui_state.current_screen != UI_SCREEN_BOOT &&
 121:Core/Src/ui/ui_state.c ****             ui_state.current_screen != UI_SCREEN_WARNING &&
 122:Core/Src/ui/ui_state.c ****             ui_state.current_screen != UI_SCREEN_CONFIRM)
 123:Core/Src/ui/ui_state.c ****         {
 124:Core/Src/ui/ui_state.c ****             _last_activity = now;
 125:Core/Src/ui/ui_state.c ****             UI_EnterSleep();
 126:Core/Src/ui/ui_state.c ****             return;
 127:Core/Src/ui/ui_state.c ****         }
 128:Core/Src/ui/ui_state.c ****     }
 129:Core/Src/ui/ui_state.c **** 
 130:Core/Src/ui/ui_state.c ****     /* -------- warnings (order: V critical > V low > temperature) -------- */
 131:Core/Src/ui/ui_state.c ****     if (ui_state.current_screen != UI_SCREEN_BOOT &&
 132:Core/Src/ui/ui_state.c ****         ui_state.current_screen != UI_SCREEN_WARNING)
 133:Core/Src/ui/ui_state.c ****     {
 134:Core/Src/ui/ui_state.c ****         uint8_t va = volt_alarm_pub(telemetry.voltage_mV);
 135:Core/Src/ui/ui_state.c ****         WarnType_t t = WARN_COUNT;
 136:Core/Src/ui/ui_state.c **** 
 137:Core/Src/ui/ui_state.c ****         if      (va == 2 && !_warn_acked[WARN_VCRIT]) t = WARN_VCRIT;
 138:Core/Src/ui/ui_state.c ****         else if (va == 1 && !_warn_acked[WARN_VLOW])  t = WARN_VLOW;
 139:Core/Src/ui/ui_state.c ****         else if (!_warn_acked[WARN_TEMP] &&
 140:Core/Src/ui/ui_state.c ****                  temp_out_of_range_pub(telemetry.temp_celsius)) t = WARN_TEMP;
 141:Core/Src/ui/ui_state.c **** 
 142:Core/Src/ui/ui_state.c ****         if (t != WARN_COUNT)
 143:Core/Src/ui/ui_state.c ****         {
ARM GAS  /tmp/ccjqjIde.s 			page 5


 144:Core/Src/ui/ui_state.c ****             _warn_active = t;
 145:Core/Src/ui/ui_state.c ****             Screen_Warning_Open(t);
 146:Core/Src/ui/ui_state.c ****             _warn_return = ui_state.current_screen;
 147:Core/Src/ui/ui_state.c ****             _warn_open_tick = now;
 148:Core/Src/ui/ui_state.c ****             UI_NavigateTo(UI_SCREEN_WARNING);
 149:Core/Src/ui/ui_state.c ****         }
 150:Core/Src/ui/ui_state.c ****     }
 151:Core/Src/ui/ui_state.c **** 
 152:Core/Src/ui/ui_state.c ****     /* Long-press detection: if the button is held for more than UI_LONG_PRESS_MS,
 153:Core/Src/ui/ui_state.c ****      * return to the main screen from anywhere. */
 154:Core/Src/ui/ui_state.c ****     if (Encoder_IsHeld())
 155:Core/Src/ui/ui_state.c ****     {
 156:Core/Src/ui/ui_state.c ****         if (ui_state.btn_press_tick == 0)
 157:Core/Src/ui/ui_state.c ****         {
 158:Core/Src/ui/ui_state.c ****             /* finger just landed: remember when */
 159:Core/Src/ui/ui_state.c ****             ui_state.btn_press_tick = now;
 160:Core/Src/ui/ui_state.c ****             ui_state.btn_was_held   = 0;
 161:Core/Src/ui/ui_state.c ****         }
 162:Core/Src/ui/ui_state.c ****         else if (!ui_state.btn_was_held &&
 163:Core/Src/ui/ui_state.c ****                  (now - ui_state.btn_press_tick) >= UI_LONG_PRESS_MS)
 164:Core/Src/ui/ui_state.c ****         {   /* finger stay long enough */
 165:Core/Src/ui/ui_state.c ****             /* held long enough: open SETTINGS overlay.
 166:Core/Src/ui/ui_state.c ****              * remember where we came from, Exit bring us back. */
 167:Core/Src/ui/ui_state.c ****             ui_state.btn_was_held = 1;
 168:Core/Src/ui/ui_state.c **** 
 169:Core/Src/ui/ui_state.c ****             if (ui_state.current_screen != UI_SCREEN_SETTINGS &&
 170:Core/Src/ui/ui_state.c ****                 ui_state.current_screen != UI_SCREEN_OUTPUT)
 171:Core/Src/ui/ui_state.c ****             {
 172:Core/Src/ui/ui_state.c ****                 _settings_return = ui_state.current_screen;
 173:Core/Src/ui/ui_state.c ****                 UI_NavigateTo(UI_SCREEN_SETTINGS);
 174:Core/Src/ui/ui_state.c ****             }
 175:Core/Src/ui/ui_state.c ****             /* inside SETTINGS you leave with "Exit" row (or double click
 176:Core/Src/ui/ui_state.c ****              * from OUTPUT page): long press do nothing here */
 177:Core/Src/ui/ui_state.c ****         }
 178:Core/Src/ui/ui_state.c ****     }
 179:Core/Src/ui/ui_state.c ****     else
 180:Core/Src/ui/ui_state.c ****     {
 181:Core/Src/ui/ui_state.c ****         /* finger gone: forget long-press state */
 182:Core/Src/ui/ui_state.c ****         ui_state.btn_press_tick = 0;
 183:Core/Src/ui/ui_state.c ****         ui_state.btn_was_held   = 0;
 184:Core/Src/ui/ui_state.c ****     }
 185:Core/Src/ui/ui_state.c **** 
 186:Core/Src/ui/ui_state.c ****     /* -------- click arbiter (one click vs two) --------
 187:Core/Src/ui/ui_state.c ****      * raw press not acted on right away: held pending UI_DOUBLE_CLICK_MS.
 188:Core/Src/ui/ui_state.c ****      * second press inside window -> DOUBLE click (jump to SETTINGS),
 189:Core/Src/ui/ui_state.c ****      * single action never fire. window pass -> clean SINGLE click out.
 190:Core/Src/ui/ui_state.c ****      * long press kill pending click. */
 191:Core/Src/ui/ui_state.c ****     uint8_t click = 0;   /* clean single click, screens below use this */
 192:Core/Src/ui/ui_state.c ****     {
 193:Core/Src/ui/ui_state.c ****         static uint32_t _pend_tick = 0;
 194:Core/Src/ui/ui_state.c ****         static uint8_t  _pend = 0;
 195:Core/Src/ui/ui_state.c **** 
 196:Core/Src/ui/ui_state.c ****         if (btn_pressed && !ui_state.btn_was_held)
 197:Core/Src/ui/ui_state.c ****         {
 198:Core/Src/ui/ui_state.c ****             if (_pend && (now - _pend_tick) <= UI_DOUBLE_CLICK_MS)
 199:Core/Src/ui/ui_state.c ****             {
 200:Core/Src/ui/ui_state.c ****                 _pend = 0;                       /* two presses = double click */
ARM GAS  /tmp/ccjqjIde.s 			page 6


 201:Core/Src/ui/ui_state.c ****                 if (ui_state.current_screen != UI_SCREEN_SETTINGS)
 202:Core/Src/ui/ui_state.c ****                 {
 203:Core/Src/ui/ui_state.c ****                     if (ui_state.current_screen != UI_SCREEN_OUTPUT)
 204:Core/Src/ui/ui_state.c ****                         _settings_return = ui_state.current_screen;
 205:Core/Src/ui/ui_state.c ****                     UI_NavigateTo(UI_SCREEN_SETTINGS);
 206:Core/Src/ui/ui_state.c ****                 }
 207:Core/Src/ui/ui_state.c ****             }
 208:Core/Src/ui/ui_state.c ****             else { _pend = 1; _pend_tick = now; }
 209:Core/Src/ui/ui_state.c ****         }
 210:Core/Src/ui/ui_state.c **** 
 211:Core/Src/ui/ui_state.c ****         /* single click come out only when button UP
 212:Core/Src/ui/ui_state.c ****          * (btn_press_tick != 0 = finger still on button: long press
 213:Core/Src/ui/ui_state.c ****          * in progress must never spit click at +400 ms) */
 214:Core/Src/ui/ui_state.c ****         if (_pend && ui_state.btn_press_tick == 0 &&
 215:Core/Src/ui/ui_state.c ****             (now - _pend_tick) > UI_DOUBLE_CLICK_MS)
 216:Core/Src/ui/ui_state.c ****         { click = 1; _pend = 0; }                /* single click come out */
 217:Core/Src/ui/ui_state.c **** 
 218:Core/Src/ui/ui_state.c ****         if (ui_state.btn_was_held) _pend = 0;    /* long press eat pending click */
 219:Core/Src/ui/ui_state.c ****     }
