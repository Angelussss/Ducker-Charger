 194:Core/Src/ui/widgets.c ****             break;
 195:Core/Src/ui/widgets.c ****         case ICON_TEMP_OK:
 196:Core/Src/ui/widgets.c ****         case ICON_TEMP_COLD:  /* same shape, colour say hot or cold */
 197:Core/Src/ui/widgets.c ****         case ICON_TEMP_WARN:  /* thermometer: stem + bulb */
