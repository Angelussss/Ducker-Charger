 179:Core/Src/ui/widgets.c ****     /* Each icon is drawn as a small geometric shape (8x8 px area).
 180:Core/Src/ui/widgets.c ****      * No bitmap images are used to save Flash memory. */
 181:Core/Src/ui/widgets.c ****     switch (type)
 182:Core/Src/ui/widgets.c ****     {
 183:Core/Src/ui/widgets.c ****         case ICON_USB_C:      /* plug outline */
 184:Core/Src/ui/widgets.c ****             GFX_DrawRoundRect(x, y + 1, 10, 6, 2, icon_color);
 185:Core/Src/ui/widgets.c ****             break;
 186:Core/Src/ui/widgets.c ****         case ICON_CHARGING:   /* zap bolt */
 187:Core/Src/ui/widgets.c ****             GFX_DrawLine(x + 6, y, x + 2, y + 5, icon_color);
 188:Core/Src/ui/widgets.c ****             GFX_DrawLine(x + 2, y + 5, x + 6, y + 4, icon_color);
 189:Core/Src/ui/widgets.c ****             GFX_DrawLine(x + 6, y + 4, x + 3, y + 8, icon_color);
 190:Core/Src/ui/widgets.c ****             break;
 191:Core/Src/ui/widgets.c ****         case ICON_FULL:       /* check mark, belly full */
