  75:Core/Src/ui/widgets.c ****     {
  76:Core/Src/ui/widgets.c ****         int32_t range   = (int32_t)val_max - val_min;
  77:Core/Src/ui/widgets.c ****         uint16_t zero_y = (uint16_t)(y + (uint32_t)h * (uint32_t)val_max / (uint32_t)range);
