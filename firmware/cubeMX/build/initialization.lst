 146:Core/Src/app/initialization.c **** /* =========================================================
 147:Core/Src/app/initialization.c ****  * Step 1: TPS25750 patch stream
 148:Core/Src/app/initialization.c ****  * ========================================================= */
 149:Core/Src/app/initialization.c **** 
 150:Core/Src/app/initialization.c **** static InitStatus_t init_tps25750(void)
 151:Core/Src/app/initialization.c **** {
 152:Core/Src/app/initialization.c ****     uint32_t mode = 0;
 153:Core/Src/app/initialization.c **** 
 154:Core/Src/app/initialization.c ****     if (tps_get_mode(&mode) != HAL_OK)
 155:Core/Src/app/initialization.c ****         return INIT_FAILED;
 156:Core/Src/app/initialization.c **** 
 157:Core/Src/app/initialization.c ****     if (mode == TPS_MODE_APP)
 158:Core/Src/app/initialization.c ****         return INIT_OK;             /* already patched (warm reboot) */
 159:Core/Src/app/initialization.c **** 
 160:Core/Src/app/initialization.c ****     if (mode != TPS_MODE_PTCH)
 161:Core/Src/app/initialization.c ****         return INIT_FAILED;         /* BOOT/unknown: needs investigation */
 162:Core/Src/app/initialization.c **** 
 163:Core/Src/app/initialization.c ****     /* --- PBMs: announce the bundle ---------------------------------
 164:Core/Src/app/initialization.c ****      * Data layout (CHECK against TRM "Patch Bundle Burst Mode"):
 165:Core/Src/app/initialization.c ****      *   [0..3] bundle size, little endian
 166:Core/Src/app/initialization.c ****      *   [4]    burst slave address (8-bit)
 167:Core/Src/app/initialization.c ****      *   [5]    timeout, units of 100 ms
 168:Core/Src/app/initialization.c ****      */
 169:Core/Src/app/initialization.c ****     {
 170:Core/Src/app/initialization.c ****         uint8_t d[6];
 171:Core/Src/app/initialization.c ****         d[0] = (uint8_t)(tps25750_bundle_size & 0xFFu);
 172:Core/Src/app/initialization.c ****         d[1] = (uint8_t)((tps25750_bundle_size >> 8) & 0xFFu);
 173:Core/Src/app/initialization.c ****         d[2] = (uint8_t)((tps25750_bundle_size >> 16) & 0xFFu);
 174:Core/Src/app/initialization.c ****         d[3] = (uint8_t)((tps25750_bundle_size >> 24) & 0xFFu);
 175:Core/Src/app/initialization.c ****         d[4] = TPS_BURST_ADDR_DEFAULT;
 176:Core/Src/app/initialization.c ****         d[5] = (uint8_t)(TPS_PATCH_TIMEOUT_MS / 100u);
 177:Core/Src/app/initialization.c **** 
 178:Core/Src/app/initialization.c ****         if (tps_write(TPS_REG_DATA1, d, sizeof(d)) != HAL_OK)
 179:Core/Src/app/initialization.c ****             return INIT_FAILED;
 180:Core/Src/app/initialization.c ****         if (tps_cmd(TPS_CMD_PBMs, 200u) != HAL_OK)
 181:Core/Src/app/initialization.c ****             return INIT_FAILED;
 182:Core/Src/app/initialization.c ****     }
 183:Core/Src/app/initialization.c **** 
 184:Core/Src/app/initialization.c ****     /* --- Burst: stream the bundle as raw writes to the burst address */
 185:Core/Src/app/initialization.c ****     {
 186:Core/Src/app/initialization.c ****         uint32_t off = 0;
 187:Core/Src/app/initialization.c ****         while (off < tps25750_bundle_size) {
 188:Core/Src/app/initialization.c ****             uint16_t n = (uint16_t)((tps25750_bundle_size - off) > TPS_BURST_CHUNK
 189:Core/Src/app/initialization.c ****                                     ? TPS_BURST_CHUNK
 190:Core/Src/app/initialization.c ****                                     : (tps25750_bundle_size - off));
 191:Core/Src/app/initialization.c ****             if (HAL_I2C_Master_Transmit(&hi2c3, TPS_BURST_ADDR_DEFAULT,
 192:Core/Src/app/initialization.c ****                                         (uint8_t *)&tps25750_bundle[off], n,
 193:Core/Src/app/initialization.c ****                                         I2C_TIMEOUT_MS) != HAL_OK) {
 194:Core/Src/app/initialization.c ****                 (void)tps_cmd(TPS_CMD_PBMe, 200u);   /* abort cleanly */
 195:Core/Src/app/initialization.c ****                 return INIT_FAILED;
 196:Core/Src/app/initialization.c ****             }
 197:Core/Src/app/initialization.c ****             off += n;
 198:Core/Src/app/initialization.c ****         }
 199:Core/Src/app/initialization.c ****     }
 200:Core/Src/app/initialization.c **** 
 201:Core/Src/app/initialization.c ****     /* --- PBMc: complete and wait for APP mode ----------------------- */
 202:Core/Src/app/initialization.c ****     if (tps_cmd(TPS_CMD_PBMc, 1000u) != HAL_OK)
ARM GAS  /tmp/cc8lanbs.s 			page 5


 203:Core/Src/app/initialization.c ****         return INIT_FAILED;
 204:Core/Src/app/initialization.c **** 
 205:Core/Src/app/initialization.c ****     {
 206:Core/Src/app/initialization.c ****         uint32_t t0 = HAL_GetTick();
 207:Core/Src/app/initialization.c ****         do {
 208:Core/Src/app/initialization.c ****             if (tps_get_mode(&mode) == HAL_OK && mode == TPS_MODE_APP)
 209:Core/Src/app/initialization.c ****                 return INIT_OK;
 210:Core/Src/app/initialization.c ****             HAL_Delay(10);
 211:Core/Src/app/initialization.c ****         } while ((HAL_GetTick() - t0) < 500u);
 212:Core/Src/app/initialization.c ****     }
 213:Core/Src/app/initialization.c **** 
 214:Core/Src/app/initialization.c ****     return INIT_FAILED;
 215:Core/Src/app/initialization.c **** }
 216:Core/Src/app/initialization.c **** 
 217:Core/Src/app/initialization.c **** /* =========================================================
 218:Core/Src/app/initialization.c ****  * Step 2: INA3221 configuration
 219:Core/Src/app/initialization.c ****  * ========================================================= */
 220:Core/Src/app/initialization.c **** 
 221:Core/Src/app/initialization.c **** static InitStatus_t init_ina3221(void)
 222:Core/Src/app/initialization.c **** {
 223:Core/Src/app/initialization.c ****     uint8_t  w[3] = { INA3221_REG_CONFIG,
 224:Core/Src/app/initialization.c ****                       (uint8_t)(INA3221_CONFIG_VALUE >> 8),
 225:Core/Src/app/initialization.c ****                       (uint8_t)(INA3221_CONFIG_VALUE & 0xFFu) };
 226:Core/Src/app/initialization.c ****     uint8_t  r[2] = { 0, 0 };
 227:Core/Src/app/initialization.c **** 
 228:Core/Src/app/initialization.c ****     if (HAL_I2C_Master_Transmit(&hi2c1, INA3221_ADDR, w, 3u,
 229:Core/Src/app/initialization.c ****                                 I2C_TIMEOUT_MS) != HAL_OK)
 230:Core/Src/app/initialization.c ****         return INIT_FAILED;
 231:Core/Src/app/initialization.c **** 
 232:Core/Src/app/initialization.c ****     /* Read back to confirm the device is alive and took the value. */
 233:Core/Src/app/initialization.c ****     if (HAL_I2C_Mem_Read(&hi2c1, INA3221_ADDR, INA3221_REG_CONFIG,
 234:Core/Src/app/initialization.c ****                          I2C_MEMADD_SIZE_8BIT, r, 2u,
 235:Core/Src/app/initialization.c ****                          I2C_TIMEOUT_MS) != HAL_OK)
 236:Core/Src/app/initialization.c ****         return INIT_FAILED;
 237:Core/Src/app/initialization.c **** 
 238:Core/Src/app/initialization.c ****     return (((uint16_t)r[0] << 8 | r[1]) == INA3221_CONFIG_VALUE)
 239:Core/Src/app/initialization.c ****            ? INIT_OK : INIT_FAILED;
 240:Core/Src/app/initialization.c **** }
 241:Core/Src/app/initialization.c **** 
