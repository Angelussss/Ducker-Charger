   1:Core/Src/app/initialization.c **** /**
   2:Core/Src/app/initialization.c ****  * @file    initialization.c
   3:Core/Src/app/initialization.c ****  * @brief   Every-boot IC initialization. See initialization.h.
   4:Core/Src/app/initialization.c ****  *
   5:Core/Src/app/initialization.c ****  * VERIFY BEFORE FIRST USE (marked CHECK):
   6:Core/Src/app/initialization.c ****  *   - TPS25750 I2C address: netlist analysis says 0x21 (ADCIN1/2 = GND);
   7:Core/Src/app/initialization.c ****  *     the charge-management branch used 0x20 with an open TODO. Confirm
   8:Core/Src/app/initialization.c ****  *     against the TPS25750 TRM table "I2C address selection".
   9:Core/Src/app/initialization.c ****  *   - The PBMs data layout and burst-write chunking against the TRM
  10:Core/Src/app/initialization.c ****  *     section "Patch Bundle Burst Mode" (document already in the repo).
  11:Core/Src/app/initialization.c ****  *   - STPD01 register encodings (VOUT/ILIM LSB) against its datasheet.
  12:Core/Src/app/initialization.c ****  *
  13:Core/Src/app/initialization.c ****  * Design rules:
  14:Core/Src/app/initialization.c ****  *   - Bounded timeouts everywhere; never HAL_MAX_DELAY (a hung bus must
  15:Core/Src/app/initialization.c ****  *     degrade the boot, not freeze the product).
  16:Core/Src/app/initialization.c ****  *   - Each step retried once before being declared failed.
  17:Core/Src/app/initialization.c ****  */
  18:Core/Src/app/initialization.c **** 
  19:Core/Src/app/initialization.c **** #include "app/initialization.h"
  20:Core/Src/app/initialization.c **** #include "main.h"
  21:Core/Src/app/initialization.c **** #include "i2c.h"        /* hi2c1 (I2C_LP), hi2c3 (I2C_PD) */
  22:Core/Src/app/initialization.c **** 
  23:Core/Src/app/initialization.c **** #include <string.h>
  24:Core/Src/app/initialization.c **** 
  25:Core/Src/app/initialization.c **** /* Patch bundle: the const array is NOT part of this branch — it gets
  26:Core/Src/app/initialization.c ****  * generated from firmware/TPS25750/TPS25750D_DuckerCharger.bin (already
  27:Core/Src/app/initialization.c ****  * in the repo) at integration time, e.g.:
  28:Core/Src/app/initialization.c ****  *   python3 -c "d=open('TPS25750D_DuckerCharger.bin','rb').read(); ..."
  29:Core/Src/app/initialization.c ****  * or xxd -i. Linking without it fails on purpose: the integrator must
  30:Core/Src/app/initialization.c ****  * pick the bundle revision consciously. */
  31:Core/Src/app/initialization.c **** extern const uint8_t  tps25750_bundle[];
ARM GAS  /tmp/cc8lanbs.s 			page 2


  32:Core/Src/app/initialization.c **** extern const uint32_t tps25750_bundle_size;
  33:Core/Src/app/initialization.c **** 
  34:Core/Src/app/initialization.c **** /* =========================================================
  35:Core/Src/app/initialization.c ****  * Bus / device constants
  36:Core/Src/app/initialization.c ****  * ========================================================= */
  37:Core/Src/app/initialization.c **** 
  38:Core/Src/app/initialization.c **** #define I2C_TIMEOUT_MS          (50u)
  39:Core/Src/app/initialization.c **** #define STEP_RETRIES            (2u)
  40:Core/Src/app/initialization.c **** 
  41:Core/Src/app/initialization.c **** /* CHECK: 0x21 per netlist (ADCIN1/2=GND); charge.h used 0x20. */
  42:Core/Src/app/initialization.c **** #define TPS25750_ADDR           (0x21u << 1)
  43:Core/Src/app/initialization.c **** 
  44:Core/Src/app/initialization.c **** /* TPS25750 host-interface registers (length-prefixed I2C payloads). */
  45:Core/Src/app/initialization.c **** #define TPS_REG_MODE            (0x03u)
  46:Core/Src/app/initialization.c **** #define TPS_REG_CMD1            (0x08u)
  47:Core/Src/app/initialization.c **** #define TPS_REG_DATA1           (0x09u)
  48:Core/Src/app/initialization.c **** 
  49:Core/Src/app/initialization.c **** /* 4CC helpers */
  50:Core/Src/app/initialization.c **** #define TPS_4CC(a,b,c,d)        ((uint32_t)(a) | ((uint32_t)(b) << 8) | \
  51:Core/Src/app/initialization.c ****                                  ((uint32_t)(c) << 16) | ((uint32_t)(d) << 24))
  52:Core/Src/app/initialization.c **** #define TPS_MODE_PTCH           TPS_4CC('P','T','C','H')
  53:Core/Src/app/initialization.c **** #define TPS_MODE_APP            TPS_4CC('A','P','P',' ')
  54:Core/Src/app/initialization.c **** #define TPS_CMD_PBMs            TPS_4CC('P','B','M','s')
  55:Core/Src/app/initialization.c **** #define TPS_CMD_PBMc            TPS_4CC('P','B','M','c')
  56:Core/Src/app/initialization.c **** #define TPS_CMD_PBMe            TPS_4CC('P','B','M','e')
  57:Core/Src/app/initialization.c **** 
  58:Core/Src/app/initialization.c **** #define TPS_PATCH_TIMEOUT_MS    (2000u)   /* whole-bundle budget */
  59:Core/Src/app/initialization.c **** #define TPS_BURST_CHUNK         (256u)    /* bytes per burst I2C write */
  60:Core/Src/app/initialization.c **** 
  61:Core/Src/app/initialization.c **** /* CHECK: burst target address is returned by PBMs; this is the default
  62:Core/Src/app/initialization.c ****  * suggested in the TRM examples. */
  63:Core/Src/app/initialization.c **** #define TPS_BURST_ADDR_DEFAULT  (0x22u << 1)
  64:Core/Src/app/initialization.c **** 
  65:Core/Src/app/initialization.c **** /* INA3221 (I2C_LP, A0=GND -> 0x40). CONFIG 0x6527:
  66:Core/Src/app/initialization.c ****  * ch1+ch2 enabled (ch3 grounded/unused), 16-sample averaging,
  67:Core/Src/app/initialization.c ****  * 1.1 ms bus & shunt conversion, continuous shunt+bus mode. */
  68:Core/Src/app/initialization.c **** #define INA3221_ADDR            (0x40u << 1)
  69:Core/Src/app/initialization.c **** #define INA3221_REG_CONFIG      (0x00u)
  70:Core/Src/app/initialization.c **** #define INA3221_CONFIG_VALUE    (0x6527u)
  71:Core/Src/app/initialization.c **** 
  72:Core/Src/app/initialization.c **** /* STPD01 (I2C_LP). CHECK: address 0x54 marked "to be verified" since
  73:Core/Src/app/initialization.c ****  * the charge-management branch; encodings below from datasheet tables.
  74:Core/Src/app/initialization.c ****  * VOUT: 3.0 V + 20 mV/LSB. ILIM: 100 mA + 100 mA/LSB. */
  75:Core/Src/app/initialization.c **** #define STPD01_ADDR             (0x54u << 1)
  76:Core/Src/app/initialization.c **** #define STPD01_REG_VOUT         (0x00u)
  77:Core/Src/app/initialization.c **** #define STPD01_REG_ILIM         (0x01u)
  78:Core/Src/app/initialization.c **** #define STPD01_REG_ENABLE       (0x06u)
  79:Core/Src/app/initialization.c **** #define STPD01_VOUT_5V          ((uint8_t)((5000u - 3000u) / 20u))
  80:Core/Src/app/initialization.c **** #define STPD01_ILIM_3A          ((uint8_t)((3000u - 100u) / 100u))
  81:Core/Src/app/initialization.c **** 
  82:Core/Src/app/initialization.c **** /* ------------------------------------------------------------------ */
  83:Core/Src/app/initialization.c **** /* TPS25750 register helpers                                           */
  84:Core/Src/app/initialization.c **** /*                                                                     */
  85:Core/Src/app/initialization.c **** /* The host interface uses length-prefixed payloads: a write is         */
  86:Core/Src/app/initialization.c **** /* [reg][len][data...], a read returns [len][data...].                  */
  87:Core/Src/app/initialization.c **** /* ------------------------------------------------------------------ */
  88:Core/Src/app/initialization.c **** 
