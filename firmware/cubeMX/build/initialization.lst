  89:Core/Src/app/initialization.c **** static HAL_StatusTypeDef tps_read(uint8_t reg, uint8_t *buf, uint8_t len)
  90:Core/Src/app/initialization.c **** {
  91:Core/Src/app/initialization.c ****     uint8_t raw[65];
  92:Core/Src/app/initialization.c **** 
  93:Core/Src/app/initialization.c ****     if (HAL_I2C_Master_Transmit(&hi2c3, TPS25750_ADDR, &reg, 1u,
  94:Core/Src/app/initialization.c ****                                 I2C_TIMEOUT_MS) != HAL_OK)
  95:Core/Src/app/initialization.c ****         return HAL_ERROR;
  96:Core/Src/app/initialization.c ****     if (HAL_I2C_Master_Receive(&hi2c3, TPS25750_ADDR, raw,
  97:Core/Src/app/initialization.c ****                                (uint16_t)(len + 1u),
  98:Core/Src/app/initialization.c ****                                I2C_TIMEOUT_MS) != HAL_OK)
  99:Core/Src/app/initialization.c ****         return HAL_ERROR;
 100:Core/Src/app/initialization.c **** 
 101:Core/Src/app/initialization.c ****     /* raw[0] = payload length as reported by the device */
 102:Core/Src/app/initialization.c ****     memcpy(buf, &raw[1], len);
 103:Core/Src/app/initialization.c ****     return HAL_OK;
 104:Core/Src/app/initialization.c **** }
 105:Core/Src/app/initialization.c **** 
 106:Core/Src/app/initialization.c **** static HAL_StatusTypeDef tps_write(uint8_t reg, const uint8_t *data,
 107:Core/Src/app/initialization.c ****                                    uint8_t len)
 108:Core/Src/app/initialization.c **** {
 109:Core/Src/app/initialization.c ****     uint8_t raw[66];
 110:Core/Src/app/initialization.c **** 
 111:Core/Src/app/initialization.c ****     raw[0] = reg;
 112:Core/Src/app/initialization.c ****     raw[1] = len;
 113:Core/Src/app/initialization.c ****     memcpy(&raw[2], data, len);
 114:Core/Src/app/initialization.c ****     return HAL_I2C_Master_Transmit(&hi2c3, TPS25750_ADDR, raw,
 115:Core/Src/app/initialization.c ****                                    (uint16_t)(len + 2u), I2C_TIMEOUT_MS);
 116:Core/Src/app/initialization.c **** }
 117:Core/Src/app/initialization.c **** 
 118:Core/Src/app/initialization.c **** /** Send a 4CC command through CMD1 and poll until it completes. */
 119:Core/Src/app/initialization.c **** static HAL_StatusTypeDef tps_cmd(uint32_t cmd, uint32_t timeout_ms)
 120:Core/Src/app/initialization.c **** {
 121:Core/Src/app/initialization.c ****     uint32_t t0 = HAL_GetTick();
 122:Core/Src/app/initialization.c ****     uint32_t readback = 0;
 123:Core/Src/app/initialization.c **** 
 124:Core/Src/app/initialization.c ****     if (tps_write(TPS_REG_CMD1, (const uint8_t *)&cmd, 4u) != HAL_OK)
 125:Core/Src/app/initialization.c ****         return HAL_ERROR;
 126:Core/Src/app/initialization.c **** 
 127:Core/Src/app/initialization.c ****     /* CMD1 reads back 0 on success, '!CMD' on rejection. */
 128:Core/Src/app/initialization.c ****     do {
 129:Core/Src/app/initialization.c ****         if (tps_read(TPS_REG_CMD1, (uint8_t *)&readback, 4u) != HAL_OK)
 130:Core/Src/app/initialization.c ****             return HAL_ERROR;
 131:Core/Src/app/initialization.c ****         if (readback == 0u)
 132:Core/Src/app/initialization.c ****             return HAL_OK;
 133:Core/Src/app/initialization.c ****         if (readback == TPS_4CC('!','C','M','D'))
 134:Core/Src/app/initialization.c ****             return HAL_ERROR;
 135:Core/Src/app/initialization.c ****         HAL_Delay(2);
 136:Core/Src/app/initialization.c ****     } while ((HAL_GetTick() - t0) < timeout_ms);
 137:Core/Src/app/initialization.c **** 
 138:Core/Src/app/initialization.c ****     return HAL_TIMEOUT;
 139:Core/Src/app/initialization.c **** }
 140:Core/Src/app/initialization.c **** 
 141:Core/Src/app/initialization.c **** static HAL_StatusTypeDef tps_get_mode(uint32_t *mode)
 142:Core/Src/app/initialization.c **** {
 143:Core/Src/app/initialization.c ****     return tps_read(TPS_REG_MODE, (uint8_t *)mode, 4u);
 144:Core/Src/app/initialization.c **** }
 145:Core/Src/app/initialization.c **** 
