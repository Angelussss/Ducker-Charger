   1:Core/Src/app/telemetry.c **** /**
   2:Core/Src/app/telemetry.c ****  * @file    telemetry.c
   3:Core/Src/app/telemetry.c ****  * @brief   Telemetry module: reads BQ34Z100 via I2C1 (I2C_LP / ISO1540).
   4:Core/Src/app/telemetry.c ****  *
   5:Core/Src/app/telemetry.c ****  * BQ25713 is on TPS25750's private I2C_EX bus — not reachable from STM32.
   6:Core/Src/app/telemetry.c ****  * Charge state is derived from BQ34Z100 CHG flag and current sign.
   7:Core/Src/app/telemetry.c ****  *
   8:Core/Src/app/telemetry.c ****  * CHECK before first use:
   9:Core/Src/app/telemetry.c ****  *   - BQ34Z100 register byte order (little-endian per TRM SLUSAW5)
  10:Core/Src/app/telemetry.c ****  *   - TTE/TTF register addresses (0x18 / 0x1A per TRM "Standard Commands")
  11:Core/Src/app/telemetry.c ****  *   - Cycle count 0x2A, SoH 0x2E, FCC 0x10 per TRM
  12:Core/Src/app/telemetry.c ****  */
  13:Core/Src/app/telemetry.c **** 
  14:Core/Src/app/telemetry.c **** #include "app/telemetry.h"
  15:Core/Src/app/telemetry.c **** #include "main.h"
