  75:Core/Src/display/ili9341.c **** 
  76:Core/Src/display/ili9341.c **** void ILI9341_Init(SPI_HandleTypeDef *hspi_ptr)
  77:Core/Src/display/ili9341.c **** {
  78:Core/Src/display/ili9341.c ****     _hspi = hspi_ptr;
  79:Core/Src/display/ili9341.c **** 
  80:Core/Src/display/ili9341.c ****     DISP_RST_LOW();
  81:Core/Src/display/ili9341.c ****     HAL_Delay(10);
  82:Core/Src/display/ili9341.c ****     DISP_RST_HIGH();
  83:Core/Src/display/ili9341.c ****     HAL_Delay(120);
  84:Core/Src/display/ili9341.c **** 
  85:Core/Src/display/ili9341.c ****     send_cmd(0x01);   /* SW reset */
  86:Core/Src/display/ili9341.c ****     HAL_Delay(150);
  87:Core/Src/display/ili9341.c ****     send_cmd(0x11);   /* Sleep Out */
  88:Core/Src/display/ili9341.c ****     HAL_Delay(120);
  89:Core/Src/display/ili9341.c **** 
  90:Core/Src/display/ili9341.c ****     send_cmd(0x3A);   /* pixel format: 16bpp RGB565 */
  91:Core/Src/display/ili9341.c ****     send_data(0x55);
  92:Core/Src/display/ili9341.c **** 
  93:Core/Src/display/ili9341.c ****     send_cmd(0x36);   /* MADCTL: portrait, RGB */
  94:Core/Src/display/ili9341.c ****     send_data(0x00);
  95:Core/Src/display/ili9341.c **** 
  96:Core/Src/display/ili9341.c ****     /* Display inversion ON: the generic 2" ST7789V modules need it,
  97:Core/Src/display/ili9341.c ****      * otherwise every colour comes out negated. If bring-up shows
  98:Core/Src/display/ili9341.c ****      * inverted colours on an actual ILI9341 panel, drop this command. */
  99:Core/Src/display/ili9341.c ****     send_cmd(0x21);
 100:Core/Src/display/ili9341.c **** 
 101:Core/Src/display/ili9341.c ****     send_cmd(0x29);   /* Display On */
 102:Core/Src/display/ili9341.c ****     HAL_Delay(25);
 103:Core/Src/display/ili9341.c ****     ILI9341_SetBrightness(100u);
 104:Core/Src/display/ili9341.c **** }
