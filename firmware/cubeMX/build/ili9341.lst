   1:Core/Src/display/ili9341.c **** /**
   2:Core/Src/display/ili9341.c ****  * @file    ili9341.c
   3:Core/Src/display/ili9341.c ****  * @brief   ILI9341 / ST7789 SPI display driver implementation.
   4:Core/Src/display/ili9341.c ****  *
   5:Core/Src/display/ili9341.c ****  * STATUS: init sequence extended for the generic 2" ST7789V modules
   6:Core/Src/display/ili9341.c ****  * (MADCTL + inversion) and backlight control added on BCKL_CTRL/PB8.
   7:Core/Src/display/ili9341.c ****  * To be verified on real hardware at bring-up.
   8:Core/Src/display/ili9341.c ****  *
   9:Core/Src/display/ili9341.c ****  * DISPLAY INIT SEQUENCE (to verify/extend with real hardware):
  10:Core/Src/display/ili9341.c ****  *   1. RST low for 10 ms  --> hardware reset
  11:Core/Src/display/ili9341.c ****  *   2. RST high, wait 120 ms --> post-reset delay
  12:Core/Src/display/ili9341.c ****  *   3. Series of SPI commands to configure:
  13:Core/Src/display/ili9341.c ****  *      - Pixel format (RGB565 = 0x55)
  14:Core/Src/display/ili9341.c ****  *      - Display orientation (MADCTL register)
  15:Core/Src/display/ili9341.c ****  *      - Gamma, timing, etc.
  16:Core/Src/display/ili9341.c ****  *   4. Sleep Out (0x11) + wait 120 ms
  17:Core/Src/display/ili9341.c ****  *   5. Display On (0x29)
  18:Core/Src/display/ili9341.c ****  *
  19:Core/Src/display/ili9341.c ****  * HOW TO SEND A COMMAND:
  20:Core/Src/display/ili9341.c ****  *   CS low -> DC low -> SPI byte -> CS high
  21:Core/Src/display/ili9341.c ****  *
  22:Core/Src/display/ili9341.c ****  * HOW TO SEND DATA (pixels):
  23:Core/Src/display/ili9341.c ****  *   CS low -> DC high -> SPI byte(s) -> CS high
  24:Core/Src/display/ili9341.c ****  */
  25:Core/Src/display/ili9341.c **** 
  26:Core/Src/display/ili9341.c **** #include "display/ili9341.h"
  27:Core/Src/display/ili9341.c **** #include "main.h"   /* DISP_CS_Pin, DISP_DC_Pin, DISP_RST_Pin, GPIOB */
  28:Core/Src/display/ili9341.c **** 
  29:Core/Src/display/ili9341.c **** /* SPI handle pointer saved during Init(). */
  30:Core/Src/display/ili9341.c **** static SPI_HandleTypeDef *_hspi = NULL;
ARM GAS  /tmp/ccNsDx3o.s 			page 2


  31:Core/Src/display/ili9341.c **** 
  32:Core/Src/display/ili9341.c **** /* =========================================================
  33:Core/Src/display/ili9341.c ****  * CONTROL PIN MACROS
  34:Core/Src/display/ili9341.c ****  *
  35:Core/Src/display/ili9341.c ****  * Using macros avoids repeating the HAL_GPIO_WritePin call every time
  36:Core/Src/display/ili9341.c ****  * and makes the code easier to read.
  37:Core/Src/display/ili9341.c ****  * ========================================================= */
  38:Core/Src/display/ili9341.c **** 
  39:Core/Src/display/ili9341.c **** #define DISP_CS_LOW()   HAL_GPIO_WritePin(DISP_CS_GPIO_Port,  DISP_CS_Pin,  GPIO_PIN_RESET)
  40:Core/Src/display/ili9341.c **** #define DISP_CS_HIGH()  HAL_GPIO_WritePin(DISP_CS_GPIO_Port,  DISP_CS_Pin,  GPIO_PIN_SET)
  41:Core/Src/display/ili9341.c **** #define DISP_DC_LOW()   HAL_GPIO_WritePin(DISP_DC_GPIO_Port,  DISP_DC_Pin,  GPIO_PIN_RESET)
  42:Core/Src/display/ili9341.c **** #define DISP_DC_HIGH()  HAL_GPIO_WritePin(DISP_DC_GPIO_Port,  DISP_DC_Pin,  GPIO_PIN_SET)
  43:Core/Src/display/ili9341.c **** #define DISP_RST_LOW()  HAL_GPIO_WritePin(DISP_RST_GPIO_Port, DISP_RST_Pin, GPIO_PIN_RESET)
  44:Core/Src/display/ili9341.c **** #define DISP_RST_HIGH() HAL_GPIO_WritePin(DISP_RST_GPIO_Port, DISP_RST_Pin, GPIO_PIN_SET)
  45:Core/Src/display/ili9341.c **** 
  46:Core/Src/display/ili9341.c **** /* =========================================================
  47:Core/Src/display/ili9341.c ****  * PRIVATE FUNCTIONS
  48:Core/Src/display/ili9341.c ****  * ========================================================= */
  49:Core/Src/display/ili9341.c **** 
  50:Core/Src/display/ili9341.c **** /**
  51:Core/Src/display/ili9341.c ****  * @brief  Send a single byte as a COMMAND (DC low).
  52:Core/Src/display/ili9341.c ****  */
  53:Core/Src/display/ili9341.c **** static void send_cmd(uint8_t cmd)
  54:Core/Src/display/ili9341.c **** {
  55:Core/Src/display/ili9341.c ****     DISP_CS_LOW();
  56:Core/Src/display/ili9341.c ****     DISP_DC_LOW();   /* DC low = command */
  57:Core/Src/display/ili9341.c ****     HAL_SPI_Transmit(_hspi, &cmd, 1, HAL_MAX_DELAY);
  58:Core/Src/display/ili9341.c ****     DISP_CS_HIGH();
  59:Core/Src/display/ili9341.c **** }
  60:Core/Src/display/ili9341.c **** 
