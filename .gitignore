# Format documentation: http://kicad-pcb.org/help/file-formats/
# Patterns are intentionally NOT root-anchored so they also match the
# KiCad projects living under PCB/<project>/.

# --- KiCad temporary / backup / local files ---
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*.tmp
*~

# Lock files (e.g. ~Project.kicad_pcb.lck, ~Project.kicad_pro.lck)
*.lck

# Project-local (per-user) settings
*.kicad_prl

# Autosave
_autosave-*
\#auto_saved_files\#
#auto_saved_files#/

# Backups (any *-backups/ or **/production/backups/ folder, at any depth)
*-backups/
**/production/backups/
*-save.pro
*-save.kicad_pcb

# Caches
fp-info-cache
*-cache.lib

# hierpcb plugin artifacts
*.hierpcb.json
*.hierpcb.log

# kidiff working data
.kidiff/

# --- Exported / generated files ---
# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# PCB output files
output/

# --- CubeMX ---
stm32cubemx/*
!stm32cubemx/*/*.ioc

# --- Python ---
.ipynb_checkpoints/

# OS
.DS_Store

# idea
.idea
CMakeLists.txt

# obsidian
.obsidian/

# build
build/

# clangd
.clangd
compile_commands.json
